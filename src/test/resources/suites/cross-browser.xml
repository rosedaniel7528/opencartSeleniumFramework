<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OpenCart Cross Browser Suite" parallel="tests" thread-count="2">
	<listeners>
		<listener class-name="com.opencart.listeners.TestListener" />
	</listeners>

	<test name="Chrome">
		<parameter name="browserName" value="chrome" />
		<classes>
			<class name="com.opencart.tests.CheckoutTest" />
			<class name="com.opencart.tests.SearchTest" />
		</classes>
	</test>

	<test name="Firefox">
		<parameter name="browserName" value="firefox" />
		<classes>
			<class name="com.opencart.tests.CheckoutTest" />
			<class name="com.opencart.tests.SearchTest" />
		</classes>
	</test>
</suite>
